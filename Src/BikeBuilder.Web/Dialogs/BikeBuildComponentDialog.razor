<MudDialog>
    <TitleContent>@Title</TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudAutocomplete T="ComponentMessage" @bind-Value="_component" Label="Component"
                             Required="true" RequiredError="Component is required"
                             SearchFunc="SearchComponentsAsync" ToStringFunc="@(c => c?.Name)"
                             MinCharacters="0" DebounceInterval="300" Clearable="true" />
            <MudNumericField @bind-Value="_quantity" Label="Quantity" Min="1" Required="true" Class="mt-3" />
            <MudDatePicker @bind-Date="_date" Label="Date" Required="true" Class="mt-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>
