@inherits ComponentInformationEditor<DropperPostComponentInformation>

<MudNumericField T="int" @bind-Value="Value.TravelMm" Label="Travel (mm)" Min="0" Class="mt-3" />
<MudSelect T="double" @bind-Value="Value.DiameterMm" Label="Diameter (mm)" Class="mt-3">
    @foreach (var diameter in DropperPostComponentInformation.Diameters)
    {
        <MudSelectItem T="double" Value="diameter">@diameter</MudSelectItem>
    }
</MudSelect>
