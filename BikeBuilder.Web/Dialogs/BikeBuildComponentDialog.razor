<MudDialog>
    <TitleContent>@Title</TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudSelect T="int" @bind-Value="_componentId" Label="Component" Required="true">
                @foreach (var component in AllComponents)
                {
                    <MudSelectItem T="int" Value="component.Id">@component.Name</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField @bind-Value="_quantity" Label="Quantity" Min="1" Required="true" Class="mt-3" />
            <MudDatePicker @bind-Date="_date" Label="Date" Required="true" Class="mt-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>
